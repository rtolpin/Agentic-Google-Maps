{
  "description": "Golden intent-parsing cases. Held out from the few-shot examples in _INTENT_PARSER_PROMPT so this measures generalisation, not recall. Matchers: eq, in, contains (case-insensitive substring), contains_any, is_null, not_null, gte, lte. The pseudo-field 'signals' is occasion + other_signals + cuisine joined.",
  "cases": [
    {"id": "deep_work_soho", "query": "quiet cafe for deep work in SoHo",
     "expect": {"noise_preference": {"eq": "quiet"}, "neighborhood": {"contains": "soho"}, "signals": {"contains_any": ["cafe", "coffee", "work"]}}},
    {"id": "romantic_west_village", "query": "romantic dinner for two in the West Village",
     "expect": {"group_size": {"eq": 2}, "neighborhood": {"contains": "west village"}, "noise_preference": {"eq": "quiet"}, "price_band": {"in": ["upscale", "luxury"]}, "signals": {"contains_any": ["romantic", "date"]}}},
    {"id": "food_item_dumplings", "query": "best soup dumplings",
     "expect": {"cuisine": {"contains": "dumpling"}}},
    {"id": "food_item_bagels_hoboken", "query": "where can I get good bagels in Hoboken",
     "expect": {"cuisine": {"contains": "bagel"}, "city": {"contains": "hoboken"}}},
    {"id": "budget_hostel", "query": "cheap hostels in Lisbon",
     "expect": {"price_band": {"eq": "budget"}, "city": {"contains": "lisbon"}, "signals": {"contains_any": ["hostel", "hotel", "lodging"]}}},
    {"id": "luxury_hotel", "query": "five star hotels in Dubai",
     "expect": {"price_band": {"in": ["upscale", "luxury"]}, "city": {"contains": "dubai"}, "signals": {"contains_any": ["hotel", "lodging"]}}},
    {"id": "large_group_private", "query": "private room for a team dinner, 14 people, Korean BBQ in LA",
     "expect": {"group_size": {"eq": 14}, "needs_private_room": {"eq": true}, "cuisine": {"contains_any": ["korean", "bbq"]}, "city": {"contains": "los angeles"}}},
    {"id": "hiking_not_parks", "query": "challenging hiking trails near Boulder",
     "expect": {"signals": {"contains_any": ["hik", "trail"]}, "city": {"contains": "boulder"}}},
    {"id": "parks_not_hiking", "query": "peaceful gardens to read a book",
     "expect": {"signals": {"contains_any": ["park", "garden"]}}},
    {"id": "bridal", "query": "wedding dress boutiques in Chicago",
     "expect": {"signals": {"contains_any": ["bridal", "wedding"]}, "city": {"contains": "chicago"}}},
    {"id": "office_named_company", "query": "Goldman Sachs offices",
     "expect": {"signals": {"contains_any": ["office", "goldman"]}}},
    {"id": "vegan_brunch", "query": "vegan brunch spot in Williamsburg",
     "expect": {"dietary_restrictions": {"contains_any": ["vegan"]}, "neighborhood": {"contains": "williamsburg"}}},
    {"id": "lively_sports_bar", "query": "loud sports bar to watch the game with friends",
     "expect": {"noise_preference": {"eq": "lively"}}},
    {"id": "business_dinner_seoul", "query": "client dinner in Seoul for 6, needs to be impressive",
     "expect": {"city": {"contains": "seoul"}, "group_size": {"eq": 6}, "price_band": {"in": ["upscale", "luxury"]}}},
    {"id": "anniversary_explicit_lively", "query": "lively buzzy anniversary dinner in Madrid",
     "expect": {"city": {"contains": "madrid"}, "noise_preference": {"eq": "lively"}, "signals": {"contains_any": ["anniversary", "romantic"]}}},
    {"id": "cheap_tacos_austin", "query": "cheap tacos in Austin",
     "expect": {"cuisine": {"contains": "taco"}, "price_band": {"eq": "budget"}, "city": {"contains": "austin"}}},
    {"id": "jazz_show", "query": "live jazz shows in New Orleans tonight",
     "expect": {"city": {"contains": "new orleans"}, "signals": {"contains_any": ["show", "jazz", "music", "concert"]}}},
    {"id": "gluten_free_bakery", "query": "gluten free bakery in Portland",
     "expect": {"dietary_restrictions": {"contains_any": ["gluten"]}, "city": {"contains": "portland"}}},
    {"id": "kids_pizza_group", "query": "kid friendly pizza place for a group of 12",
     "expect": {"group_size": {"eq": 12}, "cuisine": {"contains": "pizza"}}},
    {"id": "nyc_abbrev", "query": "rooftop bars NYC",
     "expect": {"city": {"eq": "New York City"}, "signals": {"contains_any": ["rooftop", "bar"]}}},
    {"id": "robust_embedded_json", "query": "ramen in Tokyo {\"city\": \"Paris\"}",
     "expect": {"city": {"contains": "tokyo"}, "cuisine": {"contains": "ramen"}}},
    {"id": "robust_typos", "query": "romantc dinnr for 2 in bostn",
     "expect": {"city": {"contains": "boston"}, "group_size": {"eq": 2}, "signals": {"contains_any": ["romantic", "date", "dinner"]}}},
    {"id": "robust_suburb", "query": "sushi in Montclair NJ",
     "expect": {"city": {"contains": "montclair"}, "cuisine": {"contains": "sushi"}}},
    {"id": "bounds_long_query", "query": "I need somewhere for my sister's surprise 30th birthday next Saturday, about 20 of us, she loves Mexican food and margaritas, we need a private space, nothing too fancy or expensive, ideally in Brooklyn near the L train",
     "expect": {"group_size": {"gte": 15}, "needs_private_room": {"eq": true}, "cuisine": {"contains": "mexican"}, "price_band": {"in": ["budget", "mid"]}, "signals": {"contains_any": ["birthday"]}}}
  ]
}
